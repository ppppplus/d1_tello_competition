<?xml version="1.0"?>
<package format="3">
  <name>d1_tello_competition</name>
  <version>2.0.1</version>
  <description>D1 EDU and Tello teaching simulation: walking, turning, stairs, shooting and delivery.</description>
  <maintainer email="tianbot@users.noreply.github.com">Course maintainers</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <build_depend>ignition-gazebo6</build_depend>
  <depend>ignition-transport11</depend>
  <build_depend>eigen</build_depend>
  <build_depend>nlohmann-json-dev</build_depend>
  <exec_depend>ignition-gazebo6</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
